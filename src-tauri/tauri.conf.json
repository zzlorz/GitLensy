{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitLensy",
  "version": "0.1.0",
  "identifier": "com.gitlensy.app",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitLensy",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x321.png",
      "icons/128x1281.png",
      "icons/128x128@2x1.png",
      "icons/icon.icns",
      "icons/icon1.ico"
    ]
  }
}
